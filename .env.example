# =====================================================================
# Variáveis para rodar LOCALMENTE com Docker.
#   cp .env.example .env
#   docker compose up --build
# O .env está no .gitignore e nunca deve ir para o repositório.
# Em staging/produção esses valores vêm dos secrets dos Environments
# do GitHub (veja README > Pipeline CI/CD).
# =====================================================================

# Ambiente do ASP.NET Core: Development | Staging | Production
APP_ENV=Development

# Porta da API no host (http://localhost:8080)
API_PORT=8080

# Banco SQL Server (senha exige maiúscula, minúscula, número e símbolo; não use $)
DB_NAME=ResiduosDb
DB_PASSWORD=Residuos@2026

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_SECRET=troque-esta-chave-super-secreta-com-no-minimo-32-caracteres

# Usuário da API para o POST /api/v1/auth/login
API_USER=admin
API_PASSWORD=admin123

# Swagger em /swagger
SWAGGER_ENABLED=true
